{
  "name": "@jrposada/auroria-toolkit-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": {
    "email": "jrposada.dev@gmail.com",
    "name": "Javier Rodriguez Posada"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrposada/auroria-toolkit.git"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "^10"
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "dev:db": "docker-compose --project-name auroria-toolkit up -d --wait database",
    "dev:server": "TSX_TSCONFIG_PATH=tsconfig.dev.json tsx watch src/index.ts",
    "dev": "pnpm dev:db && pnpm dev:server",
    "start": "node dist/index.js",
    "lint:eslint": "eslint .",
    "lint:format": "prettier . --check",
    "lint:types": "tsc --noEmit -p tsconfig.dev.json",
    "lint": "run-p lint:*",
    "test": "vitest run"
  },
  "dependencies": {
    "@jrposada/auroria-toolkit-shared": "workspace:*",
    "cors": "2.8.6",
    "dotenv": "catalog:",
    "drizzle-orm": "0.45.4",
    "express": "4.22.1",
    "pg": "8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "npm-run-all": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
